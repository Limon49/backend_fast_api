# Copy this file to `.env` and adjust the values you care about.
#
#   cp .env.example .env
#
# `.env` is git-ignored on purpose: that is where secrets belong, never in code.
# Every value here overrides the default in app/core/config.py.

# --- Application ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# Print every SQL statement to the console (noisy, but great while learning)
SQL_ECHO=false

# Create tables from the models on startup instead of running migrations.
# Leave this false: `uv run python -m app.scripts.init_db` owns the schema.
AUTO_CREATE_TABLES=false

# --- Database (defaults match a local Homebrew MySQL) --------------------
DB_USER=aiquest
DB_PASSWORD=aiquest123
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aiquest_db

# Full connection URL; when set it wins over the DB_* values above.
# DATABASE_URL=mysql+pymysql://aiquest:aiquest123@127.0.0.1:3306/aiquest_db

# --- CORS ----------------------------------------------------------------
# Comma separated list of browser origins, or "*" to allow every origin.
CORS_ORIGINS=*
